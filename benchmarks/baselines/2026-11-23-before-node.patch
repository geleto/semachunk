+"""Run the chunker against pinned retrieval and segmentation benchmarks."""
+
+import argparse
+from bisect import bisect_right
+from datetime import datetime, timezone
+from functools import lru_cache
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import platform
+import re
+import subprocess
+from tempfile import TemporaryDirectory
+
+os.environ["TOKENIZERS_PARALLELISM"] = "false"
+
+import numpy as np
+
+from corpora import ASSETS, sha256, squad, utf16_length, wikisection
+from encoder import VERSIONS, frozen_vectors, load_model
+
+
+HERE = Path(__file__).resolve().parent
+SIZES = (250, 500, 1000)
+CUTOFFS = (0.3, 0.4, 0.5, 0.6, 0.7)
+CONTEXT_TOKENS = 256
+
+
+def plans():
+    settings = {"sentences": {"combineChunks": False}}
+    for size in SIZES:
+        settings[f"pack-{size}"] = {"pack": True, "maxChunkSize": size}
+        for cutoff in CUTOFFS:
+            settings[f"merge-{size}-{cutoff}"] = {"maxChunkSize": size, "similarityThreshold": cutoff}
+        settings[f"merge-{size}-document"] = {"maxChunkSize": size, "mergeThresholdMode": "document"}
+        for mode, combine in [("group", False), ("group+merge", True)]:
+            settings[f"{mode}-{size}"] = {"maxChunkSize": size, "groupSentences": True, "combineChunks": combine}
+    for mode in ["group", "group+merge"]:
+        settings[f"{mode}-500-fixed"] = {**settings[f"{mode}-500"], "dynamicThresholdLowerBound": 0.5,
+                                         "dynamicThresholdUpperBound": 0.5}
+    return settings
+
+
+def write(path, data):
+    path.write_text(json.dumps(data, separators=(",", ":")), encoding="utf-8")
+
+
+def node(stage, implementation, directory, *args):
+    subprocess.run(["node", HERE / "chunk.mjs", stage, implementation, directory, *args], check=True)
+
+
+def contiguous_texts(parts, max_size):
+    lengths = list(map(utf16_length, parts))
+    for i, sentence in enumerate(parts):
+        span, size = sentence, lengths[i]
+        yield span  # A single long sentence is always a possible output.
+        for j in range(i + 1, len(parts)):
+            size += 1 + lengths[j]
+            if size > max_size:
+                break
+            span += " " + parts[j]
+            yield span
+
+
+def candidate_texts(docs, sentences):
+    texts = {}
+    for doc, parts in zip(docs, sentences, strict=True):
+        doc.align(parts)
+        texts.update(dict.fromkeys(contiguous_texts(parts, max(SIZES))))
+    for doc in docs:
+        for question, _ in doc.questions:
+            texts[question] = None
+    return list(texts)
+
+
+def indexed_chunks(docs, rows, texts):
+    """Return actual source positions, checking every output for omissions and reordering."""
+    chunks = []
+    for d, (doc, row) in enumerate(zip(docs, rows, strict=True)):
+        start = 0
+        for index in row["ids"]:
+            text = texts[index]
+            if not doc.text.startswith(text, start):
+                raise ValueError(f"Chunk does not match the source at {doc.title}, offset {start}")
+            chunks.append((d, start, index))
+            start += len(text) + 1
+        if start != len(doc.text) + 1:
+            raise ValueError(f"Incomplete chunk coverage in {doc.title}")
+    return chunks
+
+
+def retrieval(docs, chunks, vectors, ids, texts, token_ends):
+    queries = [(d, ids[q], spans) for d, doc in enumerate(docs) for q, spans in doc.questions]
+    scores = vectors[[index for _, index, _ in queries]] @ vectors[[index for _, _, index in chunks]].T
+    rankings = np.argsort(-scores, axis=1, kind="stable")
+    hits = top1 = 0
+    for (source, _, spans), ranking in zip(queries, rankings, strict=True):
+        remaining = CONTEXT_TOKENS
+        for rank, pos in enumerate(ranking):
+            d, start, index = chunks[pos]
+            ends = token_ends(texts[index])
+            take = min(len(ends), remaining)
+            if take:
+                end = start + (len(texts[index]) if take == len(ends) else ends[take - 1])
+                if source == d and any(start <= a and b <= end for a, b in spans):
+                    hits += 1
+                    top1 += int(rank == 0)
+                    break
+            remaining -= take
+            if remaining == 0:
+                break
+    return {"questions": len(queries), "hits": hits, "hitRate": hits / len(queries), "top1Hits": top1}
+
+
+def window_diff(word_starts, reference, predicted):
+    # Compare the number of cuts between words i and i+k, including the right
+    # endpoint. Character offsets allow gold cuts within a chunker's sentence.
+    n = len(word_starts)
+    k = max(1, math.floor(n / (2 * (len(reference) + 1)) + 0.5))
+    errors = 0
+    for left, right in zip(word_starts, word_starts[k:]):
+        gold = bisect_right(reference, right) - bisect_right(reference, left)
+        actual = bisect_right(predicted, right) - bisect_right(predicted, left)
+        errors += int(gold != actual)
+    return errors / (n - k)
+
+
+def segmentation(docs, chunks):
+    predicted = [[] for _ in docs]
+    for d, start, _ in chunks:
+        if start:
+            predicted[d].append(start)
+    correct = count = gold = 0
+    distances = []
+    for doc, cuts in zip(docs, predicted, strict=True):
+        correct += len(set(doc.cuts).intersection(cuts))
+        count += len(cuts)
+        gold += len(doc.cuts)
+        words = [match.start() for match in re.finditer(r"\S+", doc.text)]
+        distances.append(window_diff(words, doc.cuts, cuts))
+    return {"matched": correct, "predicted": count, "gold": gold, "precision": correct / count if count else 0,
+            "recall": correct / gold, "f1": 2 * correct / (count + gold), "windowDiff": sum(distances) / len(docs)}
+
+
+def evaluate(task, docs, implementation, settings, tokenizer, model, directory):
+    write(directory / "documents.json", [doc.text for doc in docs])
+    node("split", implementation, directory)
+    sentences = json.loads((directory / "sentences.json").read_bytes())
+    texts = candidate_texts(docs, sentences)
+    ids = {text: i for i, text in enumerate(texts)}
+    write(directory / "texts.json", texts)
+    path, vectors = frozen_vectors(texts, tokenizer, model)
+    node("chunk", implementation, directory, path)
+    runs = json.loads((directory / "runs.json").read_bytes())
+
+    @lru_cache(maxsize=None)
+    def token_ends(text):
+        return [end for _, end in tokenizer.encode(text, add_special_tokens=False).offsets]
+
+    scores = {}
+    for name, rows in runs.items():
+        scores[name] = {}
+        for split in ("calibration", "heldout"):
+            selected = [i for i, doc in enumerate(docs) if doc.split == split]
+            group = [docs[i] for i in selected]
+            batch = [rows[i] for i in selected]
+            chunks = indexed_chunks(group, batch, texts)
+            if task == "squad":
+                metrics = retrieval(group, chunks, vectors, ids, texts, token_ends)
+            else:
+                metrics = segmentation(group, chunks)
+            metrics.update(chunks=len(chunks), providerCalls=sum(row["calls"] for row in batch),
+                           providerTexts=sum(row["inputs"] for row in batch), singletonCalls=sum(row["singletons"] for row in batch))
+            scores[name][split] = metrics
+    objective = "hits" if task == "squad" else "f1"
+    grid = [name for name in settings if name.startswith("merge-")]
+    best = max(grid, key=lambda name: (scores[name]["calibration"][objective], -scores[name]["calibration"]["chunks"]))
+    print(f"{task}: calibration selected {best}; held-out {objective} = {scores[best]['heldout'][objective]}", flush=True)
+    return {"documents": {s: [d.title for d in docs if d.split == s] for s in ("calibration", "heldout")},
+            "sentences": sum(map(len, sentences)), "distinctTexts": len(texts), "vectorsSHA256": sha256(path),
+            "calibrationSelection": best, "scores": scores}
+
+
+def source_digest(paths, root):
+    digest = hashlib.sha256()
+    for path in sorted(paths):
+        digest.update(path.relative_to(root).as_posix().encode() + b"\0")
+        digest.update(path.read_text(encoding="utf-8").encode() + b"\0")
+    return digest.hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--implementation", type=Path, default=HERE.parent, help="repository tree containing src/index.js")
+    parser.add_argument("--output", type=Path, help="new JSON result file (default: timestamped file in benchmarks/results)")
+    args = parser.parse_args()
+    root = args.implementation.resolve()
+    started = datetime.now(timezone.utc)
+    out = args.output or (HERE / "results" / (started.strftime("%Y%m%dT%H%M%S%fZ") + ".json"))
+    if out.exists():
+        parser.error(f"result already exists: {out}")
+    settings = plans()
+    report = {
+        "startedUTC": started.isoformat(),
+        "implementationSHA256": source_digest([root / "config.js", *(root / "src").glob("*.js")], root),
+        "harnessSHA256": source_digest([HERE / f for f in ("chunk.mjs", "corpora.py", "encoder.py", "run.py")], HERE),
+        "node": subprocess.check_output(["node", "--version"], text=True).strip(),
+        "python": platform.python_version(), "libraries": VERSIONS,
+        "artifactsSHA256": {name: digest for name, (_, digest) in ASSETS.items()},
+        "contextTokens": CONTEXT_TOKENS, "plans": settings,
+    }
+    tokenizer, model = load_model()
+    with TemporaryDirectory() as temp:
+        directory = Path(temp)
+        write(directory / "plans.json", settings)
+        for task, load in [("squad", squad), ("wikisection", wikisection)]:
+            print(f"Running {task}", flush=True)
+            report[task] = evaluate(task, load(), root, settings, tokenizer, model, directory)
+    serialized = json.dumps(report, indent=2, allow_nan=False) + "\n"
+    out.parent.mkdir(parents=True, exist_ok=True)
+    with out.open("x", encoding="utf-8", newline="\n") as target:
+        target.write(serialized)
+    print(f"Saved {out}", flush=True)
+
+
+if __name__ == "__main__":
+    main()
