diff --git b/benchmarks/chunk.mjs b/benchmarks/chunk.mjs
new file mode 100644
index 0000000..51950af
--- /dev/null
+++ b/benchmarks/chunk.mjs
@@ -0,0 +1,93 @@
+import { readFileSync, readSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const [stage, implementation, dir, vectorFile] = process.argv.slice(2);
+const { chunkText } = await import(pathToFileURL(join(implementation, 'src/index.js')));
+const read = name => JSON.parse(readFileSync(join(dir, name + '.json'), 'utf8'));
+const write = (name, data) => writeFileSync(join(dir, name + '.json'), JSON.stringify(data));
+const docs = read('documents');
+// The Python runner owns the exact pinned model tokenizer. Only token-limited
+// methods use this local pipe. All embedding callbacks still receive batches.
+const tokenCounts = new Map();
+const reply = Buffer.alloc(32);
+function countTokens(text) {
+    if (!tokenCounts.has(text)) {
+        writeFileSync(1, JSON.stringify(text) + '\n');
+        let end = 0;
+        while (end < reply.length && (end === 0 || reply[end - 1] !== 10)) {
+            const n = readSync(0, reply, end, reply.length - end);
+            if (!n) throw new Error('Tokenizer pipe closed');
+            end += n;
+        }
+        if (reply[end - 1] !== 10) throw new Error('Invalid tokenizer reply');
+        tokenCounts.set(text, Number(reply.toString('ascii', 0, end).trim()));
+    }
+    return tokenCounts.get(text);
+}
+
+if (stage === 'split') {
+    const sentences = [];
+    const unexpected = () => { throw new Error('Splitting requested embeddings'); };
+    for (const doc of docs) {
+        const options = { combineChunks: false, groupSentences: false, returnEmbedding: false };
+        if (process.argv.includes('--token-split')) Object.assign(options, { maxChunkTokens: 256, countTokens });
+        const chunks = await chunkText(doc, unexpected, options);
+        sentences.push(chunks.map(c => c.text));
+    }
+    write('sentences', sentences);
+} else if (stage === 'chunk') {
+    const sentences = read('sentences');
+    const texts = read('texts');
+    const ids = new Map(texts.map((s, i) => [s, i]));
+    const bytes = readFileSync(vectorFile);
+    const matrix = new Float32Array(bytes.buffer, bytes.byteOffset, bytes.byteLength / 4);
+    if (matrix.length !== texts.length * 384) throw new Error('Embedding matrix size mismatch');
+    const id = text => {
+        if (!ids.has(text)) throw new Error('Chunk text missing from the frozen vectors: ' + text.slice(0, 80));
+        return ids.get(text);
+    };
+    const results = {};
+    let flatDocs;
+    for (const [name, options] of Object.entries(read('plans'))) {
+        results[name] = [];
+        for (let i = 0; i < docs.length; i++) {
+            let calls = 0, inputs = 0, singletons = 0;
+            const embed = async batch => {
+                if (options.maxChunkTokens && batch.some(s => countTokens(s) > options.maxChunkTokens)) {
+                    throw new Error('Token limit exceeded in an embedding request');
+                }
+                calls++;
+                inputs += batch.length;
+                if (batch.length === 1) singletons++;
+                return batch.map(s => {
+                    const start = id(s) * 384;
+                    return matrix.subarray(start, start + 384);
+                });
+            };
+            let output;
+            if (options.pack) {
+                output = [];
+                for (const sentence of sentences[i]) {
+                    const last = output.length - 1;
+                    if (last >= 0 && output[last].length + 1 + sentence.length <= options.maxChunkSize) {
+                        output[last] += ' ' + sentence;
+                    } else {
+                        output.push(sentence);
+                    }
+                }
+                await embed([...new Set(output)]); // Include indexing cost on the same terms as chunkText.
+            } else {
+                if (options.flatInput) flatDocs ??= read('flat-documents');
+                const input = options.flatInput ? flatDocs[i] : docs[i];
+                const chunkOptions = { ...options, returnEmbedding: true };
+                if (options.maxChunkTokens) chunkOptions.countTokens = countTokens;
+                output = (await chunkText(input, embed, chunkOptions)).map(c => c.text);
+            }
+            results[name].push({ ids: output.map(id), calls, inputs, singletons });
+        }
+    }
+    write('runs', results);
+} else {
+    throw new Error('Unknown benchmark stage: ' + stage);
+}
diff --git b/benchmarks/corpora.py b/benchmarks/corpora.py
new file mode 100644
index 0000000..550139b
--- /dev/null
+++ b/benchmarks/corpora.py
@@ -0,0 +1,159 @@
+"""Pinned public data and source offsets for the two evaluation tasks."""
+
+from bisect import bisect_right
+from dataclasses import dataclass, field
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import tarfile
+from tempfile import NamedTemporaryFile
+from urllib.request import urlopen
+
+
+CACHE = Path(__file__).resolve().parent / ".cache"
+MODEL = "https://huggingface.co/sentence-transformers/all-MiniLM-L6-v2/resolve/1110a243fdf4706b3f48f1d95db1a4f5529b4d41"
+ASSETS = {
+    "squad.json": (
+        "https://raw.githubusercontent.com/rajpurkar/SQuAD-explorer/eee5fdbf62f8613a7812b03419e6b29617b74fd1/dataset/dev-v1.1.json",
+        "95aa6a52d5d6a735563366753ca50492a658031da74f301ac5238b03966972c9"),
+    "wikisection.tar.gz": (
+        "https://raw.githubusercontent.com/sebastianarnold/WikiSection/9d1bd55da4bc2dc985b5f4493e8214caa86100b8/wikisection_dataset_json.tar.gz",
+        "f37810a95702737b153a3034dbb877d08ecc699900f1a01c70110d47a5a016b8"),
+    "tokenizer.json": (MODEL + "/tokenizer.json", "be50c3628f2bf5bb5e3a7f17b1f74611b2561a3a27eeab05e5aa30f411572037"),
+    "model.onnx": (MODEL + "/onnx/model_quint8_avx2.onnx", "b941bf19f1f1283680f449fa6a7336bb5600bdcd5f84d10ddc5cd72218a0fd21"),
+}
+
+
+def sha256(path):
+    with path.open("rb") as file:
+        return hashlib.file_digest(file, "sha256").hexdigest()
+
+
+def fetch(name, assets=ASSETS):
+    CACHE.mkdir(exist_ok=True)
+    path = CACHE / name
+    url, digest = assets[name]
+    if path.is_file() and sha256(path) == digest:
+        return path
+    with NamedTemporaryFile(dir=CACHE, delete=False) as file:
+        tmp = Path(file.name)
+    try:
+        print(f"Downloading {name}", flush=True)
+        with urlopen(url, timeout=120) as source, tmp.open("wb") as dest:
+            shutil.copyfileobj(source, dest)
+        if sha256(tmp) != digest:
+            raise ValueError(f"Checksum mismatch for {name}")
+        tmp.replace(path)
+    finally:
+        tmp.unlink(missing_ok=True)
+    return path
+
+
+def compact(text):
+    return " ".join(text.split())
+
+
+def utf16_length(text):
+    return len(text.encode("utf-16-le")) // 2
+
+
+@dataclass
+class Document:
+    title: str
+    split: str
+    text: str
+    questions: list = field(default_factory=list)  # (query, list of half-open answer spans)
+    cuts: list = field(default_factory=list)  # starts of sections after the first
+    source_text: str | None = None  # Original layout for chunking; annotations use compact text.
+
+    def align(self, sentences):
+        """Translate gold coordinates to the exact strings returned by chunkText."""
+        original, joined = [], []
+        cursor = offset = 0
+        for sentence in sentences:
+            start = self.text.index(sentence, cursor)
+            if self.text[cursor:start].strip():
+                raise ValueError(f"Sentence splitter skipped content in {self.title}")
+            original.append(start)
+            joined.append(offset)
+            cursor = start + len(sentence)
+            offset += len(sentence) + 1
+        if not sentences or self.text[cursor:].strip():
+            raise ValueError(f"Incomplete sentence coverage in {self.title}")
+
+        def translate(position):
+            i = bisect_right(original, position) - 1
+            if i < 0 or position >= original[i] + len(sentences[i]):
+                raise ValueError(f"Annotation outside sentence text in {self.title}")
+            return joined[i] + position - original[i]
+
+        self.questions = [(q, [(translate(a), translate(b - 1) + 1) for a, b in spans])
+                          for q, spans in self.questions]
+        self.cuts = [translate(start) for start in self.cuts]
+        self.text = " ".join(sentences)
+        return translate
+
+
+def answer_span(raw, normalized, answer):
+    start, literal = answer["answer_start"], answer["text"]
+    if raw[start:start + len(literal)] != literal:
+        return None
+    prefix = raw[:start + len(literal) - len(literal.lstrip())]
+    trimmed = compact(prefix)
+    begin = len(trimmed) + int(bool(trimmed and prefix[-1].isspace()))
+    content = compact(literal)
+    if content and normalized[begin:begin + len(content)] == content:
+        return begin, begin + len(content)
+    return None
+
+
+def squad():
+    articles = json.loads(fetch("squad.json").read_bytes())["data"]
+    docs = []
+    for i, article in enumerate(articles[::3]):
+        paragraphs, questions = [], []
+        offset = 0
+        for paragraph in article["paragraphs"][:8]:
+            raw = paragraph["context"]
+            text = compact(raw)
+            for qa in paragraph["qas"]:
+                spans = set()
+                for answer in qa["answers"]:
+                    span = answer_span(raw, text, answer)
+                    if span:
+                        spans.add((offset + span[0], offset + span[1]))
+                if not spans:
+                    raise ValueError(f"No aligned reference for SQuAD question {qa['id']}")
+                questions.append((qa["question"], sorted(spans)))
+            paragraphs.append(text)
+            offset += len(text) + 1
+        split = "calibration" if i % 2 == 0 else "heldout"
+        docs.append(Document(article["title"], split, " ".join(paragraphs), questions))
+    return docs
+
+
+def wikisection():
+    docs = []
+    with tarfile.open(fetch("wikisection.tar.gz")) as archive:
+        for source, split in [("validation", "calibration"), ("test", "heldout")]:
+            articles = json.load(archive.extractfile(f"wikisection_en_city_{source}.json"))
+            for i in range(8):
+                article = articles[i * len(articles) // 8]
+                raw = article["text"].encode("utf-16-le")
+                sections, cuts = [], []
+                offset = 0
+                for annotation in article["annotations"]:
+                    start = annotation["begin"] * 2
+                    end = start + annotation["length"] * 2
+                    section = compact(raw[start:end].decode("utf-16-le"))
+                    if not section:
+                        raise ValueError(f"Empty section in {article['title']}")
+                    cuts.append(offset)
+                    sections.append(section)
+                    offset += len(section) + 1
+                text = " ".join(sections)
+                if text != compact(article["text"]):
+                    raise ValueError(f"Section annotations omit text in {article['title']}")
+                docs.append(Document(article["id"], split, text, cuts=cuts[1:]))
+    return docs
diff --git b/benchmarks/encoder.py b/benchmarks/encoder.py
new file mode 100644
index 0000000..e8a9fad
--- /dev/null
+++ b/benchmarks/encoder.py
@@ -0,0 +1,69 @@
+"""Freeze a shared MiniLM embedding for every candidate text and question."""
+
+import hashlib
+import json
+from pathlib import Path
+from tempfile import NamedTemporaryFile
+
+import numpy as np
+import onnxruntime as ort
+import tokenizers
+
+from corpora import ASSETS, CACHE, fetch
+
+
+DIMENSION = 384
+VERSIONS = {"numpy": np.__version__, "onnxruntime": ort.__version__, "tokenizers": tokenizers.__version__}
+
+
+def encode(texts, tokenizer, model):
+    encodings = tokenizer.encode_batch(texts)
+    order = sorted(range(len(texts)), key=lambda i: len(encodings[i].ids))
+    vectors = np.empty((len(order), DIMENSION), dtype="<f4")
+    options = ort.SessionOptions()
+    options.intra_op_num_threads = 3
+    options.inter_op_num_threads = 1
+    session = ort.InferenceSession(str(model), options, providers=["CPUExecutionProvider"])
+    sep = tokenizer.token_to_id("[SEP]")
+    for offset in range(0, len(order), 24):
+        batch = order[offset:offset + 24]
+        rows = [encodings[i].ids for i in batch]
+        rows = [row if len(row) <= 256 else row[:255] + [sep] for row in rows]
+        ids = np.zeros((len(rows), max(map(len, rows))), dtype=np.int64)
+        mask = np.zeros_like(ids)
+        for i, row in enumerate(rows):
+            ids[i, :len(row)] = row
+            mask[i, :len(row)] = 1
+        hidden = session.run(None, {"input_ids": ids, "attention_mask": mask, "token_type_ids": np.zeros_like(ids)})[0]
+        pooled = (hidden * mask[:, :, None]).sum(axis=1) / mask.sum(axis=1)[:, None]
+        vectors[batch] = pooled / np.linalg.norm(pooled, axis=1, keepdims=True)
+    return vectors
+
+
+def frozen_vectors(texts, tokenizer, model):
+    # Quantized inference depends on batch composition. Include the ordered texts,
+    # encoder implementation and artifact versions in the key; reuse the same bytes.
+    key = hashlib.sha256(Path(__file__).read_text(encoding="utf-8").encode())
+    for item in [VERSIONS, ASSETS["model.onnx"][1], ASSETS["tokenizer.json"][1], texts]:
+        key.update(json.dumps(item, separators=(",", ":")).encode())
+    path = CACHE / (key.hexdigest() + ".f32")
+    if not path.exists():
+        print(f"Embedding {len(texts):,} distinct texts in batches of 24", flush=True)
+        vectors = encode(texts, tokenizer, model)
+        with NamedTemporaryFile(dir=CACHE, delete=False) as file:
+            tmp = Path(file.name)
+        try:
+            vectors.tofile(tmp)
+            tmp.replace(path)
+        finally:
+            tmp.unlink(missing_ok=True)
+    if path.stat().st_size != len(texts) * DIMENSION * 4:
+        raise ValueError(f"Incomplete vector cache at {path}")
+    return path, np.memmap(path, dtype="<f4", mode="r", shape=(len(texts), DIMENSION))
+
+
+def load_model():
+    tokenizer = tokenizers.Tokenizer.from_file(str(fetch("tokenizer.json")))
+    tokenizer.no_padding()
+    tokenizer.no_truncation()
+    return tokenizer, fetch("model.onnx")
diff --git b/benchmarks/rag.py b/benchmarks/rag.py
new file mode 100644
index 0000000..14d0c02
--- /dev/null
+++ b/benchmarks/rag.py
@@ -0,0 +1,376 @@
+"""Evaluate retrieval of complete supporting evidence from real documents."""
+
+import argparse
+from bisect import bisect_left, bisect_right
+from collections import Counter, defaultdict
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from functools import lru_cache
+from importlib.metadata import version
+import json
+import math
+from pathlib import Path
+import platform
+import re
+import statistics
+import subprocess
+from tempfile import TemporaryDirectory
+
+from run import HERE, contiguous_texts, indexed_chunks, node, plans, source_digest, write
+import numpy as np
+
+import rag_data
+from corpora import ASSETS, compact, sha256
+from encoder import VERSIONS, frozen_vectors, load_model
+
+
+BUDGETS = (256, 512, 1024)
+METHODS = ("sentences", "pack-500", "merge-250-0.5", "merge-500-0.3", "merge-500-0.5", "merge-500-0.7", "group+merge-500",
+           "flat-merge-500-0.5", "merge-500-document", "merge-500-token-256", "merge-500-two-passes")
+WINDOW, OVERLAP = 128, 32
+WINDOW_NAME = "window-128-overlap-32"
+TASKS = {"cuad": rag_data.cuad, "qasper": rag_data.qasper, "hotpotqa": rag_data.hotpot}
+
+
+@dataclass
+class SourceTokens:
+    starts: list[int]
+    ends: list[int]
+    base: int  # Corpus-wide IDs distinguish identical text at different source positions.
+
+    def span(self, char_start, char_end):
+        return bisect_right(self.ends, char_start), bisect_left(self.starts, char_end)
+
+
+@dataclass(frozen=True)
+class Passage:
+    doc: int
+    start: int
+    end: int
+    text_id: int
+
+
+def node_with_tokenizer(stage, root, directory, tokenizer, *args):
+    cmd = ["node", HERE / "chunk.mjs", stage, root, directory, *args]
+    with subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, encoding="utf-8") as proc:
+        try:
+            for line in proc.stdout:
+                proc.stdin.write(str(len(tokenizer.encode(json.loads(line)).ids)) + "\n")
+                proc.stdin.flush()
+        except BaseException:
+            proc.kill()
+            raise
+        finally:
+            proc.stdin.close()
+        if proc.wait():
+            raise subprocess.CalledProcessError(proc.returncode, cmd)
+
+
+def prepare(docs, questions, root, directory, tokenizer, settings):
+    flat = [doc.text for doc in docs]
+    inputs = [doc.source_text if doc.source_text is not None else doc.text for doc in docs]
+    if any(compact(raw) != normalized for raw, normalized in zip(inputs, flat, strict=True)):
+        raise ValueError("Raw layout and annotation text disagree")
+    flat_parts = None
+    if any(plan.get("flatInput") for plan in settings.values()):
+        write(directory / "flat-documents.json", flat)
+        write(directory / "documents.json", flat)
+        node("split", root, directory)
+        flat_parts = json.loads((directory / "sentences.json").read_bytes())
+    write(directory / "documents.json", inputs)
+    limited = any(plan.get("maxChunkTokens") for plan in settings.values())
+    if limited:
+        node_with_tokenizer("split", root, directory, tokenizer, "--token-split")
+        limited_parts = json.loads((directory / "sentences.json").read_bytes())
+    node("split", root, directory)
+    sentences = json.loads((directory / "sentences.json").read_bytes())
+    translators, sources, windows = [], [], []
+    ids = {}
+
+    def intern(text):
+        return ids.setdefault(text, len(ids))
+
+    base = 0
+    for d, (doc, parts) in enumerate(zip(docs, sentences, strict=True)):
+        translators.append(doc.align(parts))
+        for text in contiguous_texts(parts, 500):
+            intern(text)
+        # All methods rank with one matrix, including the flattened-input control.
+        if flat_parts is not None:
+            if " ".join(flat_parts[d]) != doc.text:
+                raise ValueError(f"Flat control needs different source coordinates in {doc.title}")
+            for text in contiguous_texts(flat_parts[d], 500):
+                intern(text)
+        if limited:
+            # Over-budget sentences are terminal; only their actual output pieces
+            # need additional vectors. The scorer below verifies their source spans.
+            for text in limited_parts[d]:
+                intern(text)
+        offsets = tokenizer.encode(doc.text, add_special_tokens=False).offsets
+        source = SourceTokens([a for a, _ in offsets], [b for _, b in offsets], base)
+        if not offsets:
+            raise ValueError(f"Empty tokenized source {doc.title}")
+        sources.append(source)
+        base += len(offsets)
+        for start in range(0, len(offsets), WINDOW - OVERLAP):
+            end = min(start + WINDOW, len(offsets))
+            text = doc.text[source.starts[start]:source.ends[end - 1]]
+            windows.append(Passage(d, start, end, intern(text)))
+            if end == len(offsets):
+                break
+
+    gold = []
+    for query in questions:
+        intern(query.text)
+        alternatives = []
+        for reference in query.references:
+            tokens = set()
+            for d, a, b in reference:
+                if d not in query.pool:
+                    raise ValueError(f"Evidence outside the search pool for {query.id}")
+                translate = translators[d]
+                start, end = sources[d].span(translate(a), translate(b - 1) + 1)
+                if end <= start:
+                    raise ValueError(f"Evidence covers no source tokens for {query.id}")
+                tokens.update(range(sources[d].base + start, sources[d].base + end))
+            if tokens not in alternatives:
+                alternatives.append(tokens)
+        if not alternatives or not all(alternatives):
+            raise ValueError(f"Missing reference for {query.id}")
+        gold.append(alternatives)
+    return ids, sources, windows, gold
+
+
+def bm25_rank(queries, passages):
+    """Rank a question's available chunks with BM25 (k1=1.2, b=0.75)."""
+    postings = defaultdict(list)
+    lengths = []
+    for i, terms in enumerate(passages):
+        lengths.append(sum(terms.values()))
+        for word, count in terms.items():
+            postings[word].append((i, count))
+    n = len(passages)
+    mean = sum(lengths) / n or 1
+    norms = [1.2 * (0.25 + 0.75 * length / mean) for length in lengths]
+    for terms in queries:
+        scores = np.zeros(n)
+        for word in terms:
+            matches = postings.get(word, ())
+            idf = math.log1p((n - len(matches) + 0.5) / (len(matches) + 0.5))
+            for i, count in matches:
+                scores[i] += idf * count * 2.2 / (count + norms[i])
+        yield np.argsort(-scores, kind="stable")
+
+
+def evidence_at_budget(ranked, sources, references, budget, trace=None):
+    visible = set()
+    spent = 0
+    for passage in ranked:
+        take = min(passage.end - passage.start, budget - spent)
+        start = sources[passage.doc].base + passage.start
+        visible.update(range(start, start + take))
+        spent += take
+        if trace is not None:
+            trace.append([passage.doc, passage.start, passage.start + take])
+        if spent == budget:
+            break
+    if not spent:
+        raise ValueError("Ranked passages contain no tokens")
+    # Accept a single annotator's complete explanation. Mixing parts from
+    # different annotators can otherwise manufacture a fully supported answer.
+    matches = [(len(gold & visible), len(gold)) for gold in references]
+    correct, gold_size = max(matches, key=lambda pair: (pair[0] / pair[1], pair[0]))
+    recall = correct / gold_size
+    return {"evidenceRecall": recall, "contextPrecision": correct / spent, "complete": int(recall == 1),
+            "budgetFeasible": int(any(len(gold) <= budget for gold in references)), "tokensDelivered": spent}
+
+
+def distribution(values):
+    return {"min": min(values), "median": statistics.median(values), "max": max(values)}
+
+
+def score_method(questions, pools, by_doc, sources, gold, ids, vectors, terms, examples):
+    totals = defaultdict(Counter)
+    for pool, members in pools.items():
+        passages = [p for d in pool for p in by_doc[d]]
+        indices = [p.text_id for p in passages]
+        query_ids = [ids[questions[i].text] for i in members]
+        dense = vectors[query_ids] @ vectors[indices].T
+        rankings = {
+            "minilm": np.argsort(-dense, axis=1, kind="stable"),
+            "bm25": bm25_rank((terms(i) for i in query_ids), [terms(i) for i in indices]),
+        }
+        for ranker, orders in rankings.items():
+            for i, order in zip(members, orders, strict=True):
+                ranked = [passages[j] for j in order]
+                for budget in BUDGETS:
+                    trace = [] if i in examples and ranker == "minilm" and budget == 256 else None
+                    score = evidence_at_budget(ranked, sources, gold[i], budget, trace)
+                    totals[ranker, budget].update(score)
+                    if trace is not None:
+                        examples[i].update(score=score, retrievedSourceTokenRanges=trace)
+    result = {}
+    for (ranker, budget), counts in totals.items():
+        n = len(questions)
+        result.setdefault(ranker, {})[budget] = {
+            "questions": n, "complete": counts["complete"], "budgetFeasible": counts["budgetFeasible"],
+            "evidenceRecall": counts["evidenceRecall"] / n, "contextPrecision": counts["contextPrecision"] / n,
+            "meanTokensDelivered": counts["tokensDelivered"] / n,
+        }
+    return result
+
+
+def examine_examples(task, questions, gold, sources):
+    # Select examples from the source labels before ranking any passages.
+    if task == "cuad":
+        governing_law = [i for i, q in enumerate(questions) if q.id.endswith("__Governing Law")]
+        indices = [max(governing_law, key=lambda i: len(sources[questions[i].pool[0]].starts))]
+    elif task == "qasper":
+        indices = [next(i for i, q in enumerate(questions) if all(len(set(ref)) > 1 for ref in q.references))]
+    else:
+        indices = [next(i for i, q in enumerate(questions) if q.kind == kind) for kind in ("bridge", "comparison")]
+    examples = {}
+    for i in indices:
+        q = questions[i]
+        references = []
+        for alternative in gold[i]:
+            spans = []
+            for d in q.pool:
+                source = sources[d]
+                positions = sorted(t - source.base for t in alternative if source.base <= t < source.base + len(source.starts))
+                for pos in positions:
+                    if spans and spans[-1][0] == d and spans[-1][2] == pos:
+                        spans[-1][2] += 1
+                    else:
+                        spans.append([d, pos, pos + 1])
+            references.append(spans)
+        examples[i] = {"questionId": q.id, "question": q.text, "candidateDocumentIndices": q.pool,
+                       "referenceSourceTokenRanges": references}
+    return examples
+
+
+def evaluate(task, root, directory, tokenizer, model, settings):
+    docs, questions, excluded = TASKS[task]()
+    ids, sources, windows, gold = prepare(docs, questions, root, directory, tokenizer, settings)
+    texts = list(ids)
+    path, vectors = frozen_vectors(texts, tokenizer, model)
+    write(directory / "texts.json", texts)
+    if any(plan.get("maxChunkTokens") for plan in settings.values()):
+        node_with_tokenizer("chunk", root, directory, tokenizer, path)
+    else:
+        node("chunk", root, directory, path)
+    runs = json.loads((directory / "runs.json").read_bytes())
+    pools = defaultdict(list)
+    for i, query in enumerate(questions):
+        pools[query.pool].append(i)
+    # Reuse the exact same article chunks and gold positions for open retrieval.
+    all_articles = {tuple(range(len(docs))): range(len(questions))} if task == "hotpotqa" else None
+    examples = examine_examples(task, questions, gold, sources) if "merge-500-0.5" in settings else {}
+    pooled_examples = {i: {} for i in examples} if all_articles else {}
+
+    @lru_cache(maxsize=None)
+    def terms(index):
+        return Counter(re.findall(r"\w+", texts[index].casefold()))
+
+    @lru_cache(maxsize=None)
+    def exceeds_model_input(index):
+        return len(tokenizer.encode(texts[index]).ids) > 256
+
+    scores = {}
+    for name in [*settings, WINDOW_NAME]:
+        by_doc = [[] for _ in docs]
+        if name == WINDOW_NAME:
+            for p in windows:
+                by_doc[p.doc].append(p)
+            batches = [len({p.text_id for p in group}) for group in by_doc]
+            calls, inputs, singles = len(batches), sum(batches), batches.count(1)
+        else:
+            rows = runs[name]
+            for d, start, index in indexed_chunks(docs, rows, texts):
+                a, b = sources[d].span(start, start + len(texts[index]))
+                if a < b:
+                    by_doc[d].append(Passage(d, a, b, index))
+            for d, group in enumerate(by_doc):
+                if not group or group[0].start != 0 or group[-1].end != len(sources[d].starts) or any(
+                        p.end != q.start for p, q in zip(group, group[1:])):
+                    raise ValueError(f"Chunks do not partition the source tokens in {docs[d].title}")
+            calls, inputs, singles = (sum(r[field] for r in rows) for field in ("calls", "inputs", "singletons"))
+        scores[name] = {
+            "chunks": sum(map(len, by_doc)), "providerCalls": calls, "providerTexts": inputs, "singletonCalls": singles,
+            "chunkTokens": distribution([p.end - p.start for group in by_doc for p in group]),
+            "chunksOverModelInput": sum(exceeds_model_input(p.text_id) for group in by_doc for p in group),
+            "retrieval": score_method(questions, pools, by_doc, sources, gold, ids, vectors, terms,
+                                      examples if name == "merge-500-0.5" else {}),
+        }
+        if all_articles:
+            scores[name]["pooledRetrieval"] = score_method(questions, all_articles, by_doc, sources, gold, ids, vectors, terms,
+                                                          pooled_examples if name == "merge-500-0.5" else {})
+    for i, trace in pooled_examples.items():
+        examples[i]["pooledAt256"] = trace
+    lengths = [len(source.starts) for source in sources]
+    summary = f"{task}: {len(questions)} questions; {len(docs)} documents"
+    if "merge-500-0.5" in scores:
+        summary += f"; default complete at 256 = {scores['merge-500-0.5']['retrieval']['minilm'][256]['complete']}"
+    print(summary, flush=True)
+    return {
+        "documents": [doc.title for doc in docs], "questionIds": [q.id for q in questions], "exclusions": dict(excluded),
+        "corpusTokens": sum(lengths),
+        "documentTokens": distribution(lengths),
+        "candidatePoolTokensPerQuestion": distribution([sum(lengths[d] for d in q.pool) for q in questions]),
+        "candidateDocumentsPerQuestion": distribution([len(q.pool) for q in questions]),
+        "shortestReferenceTokens": distribution([min(map(len, ref)) for ref in gold]),
+        "requiresMultipleSources": sum(all(len({d for d, _, _ in ref}) > 1 for ref in q.references) for q in questions),
+        "requiresMultipleSpans": sum(all(len(set(ref)) > 1 for ref in q.references) for q in questions),
+        "distinctTexts": len(texts), "vectorsSHA256": sha256(path), "scores": scores,
+        "defaultExamplesAt256": list(examples.values()),
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--task", choices=["all", *TASKS], default="all")
+    parser.add_argument("--implementation", type=Path, default=HERE.parent)
+    parser.add_argument("--methods", nargs="+", choices=METHODS, default=METHODS, help="chunker settings to compare with the token window")
+    parser.add_argument("--output", type=Path, help="new result file in JSON format")
+    args = parser.parse_args()
+    root = args.implementation.resolve()
+    started = datetime.now(timezone.utc)
+    out = args.output or HERE / "results" / ("rag-" + started.strftime("%Y%m%dT%H%M%S%fZ") + ".json")
+    if out.exists():
+        parser.error(f"result already exists: {out}")
+    tasks = list(TASKS) if args.task == "all" else [args.task]
+    assets = {k: ASSETS[k] for k in ("model.onnx", "tokenizer.json")}
+    files = {"cuad": "cuad.zip", "qasper": "qasper-test.tgz", "hotpotqa": "hotpot.parquet"}
+    assets.update({files[t]: rag_data.ASSETS[files[t]] for t in tasks})
+    grid = plans()
+    grid.update({
+        "flat-merge-500-0.5": {**grid["merge-500-0.5"], "flatInput": True},
+        "merge-500-token-256": {**grid["merge-500-0.5"], "maxChunkTokens": 256},
+        "merge-500-two-passes": {**grid["merge-500-0.5"], "maxPasses": 2},
+    })
+    settings = {name: grid[name] for name in args.methods}
+    report = {
+        "startedUTC": started.isoformat(), "implementationSHA256": source_digest([root / "config.js", *(root / "src").glob("*.js")], root),
+        "harnessSHA256": source_digest([HERE / f for f in ("chunk.mjs", "corpora.py", "encoder.py", "run.py", "rag.py", "rag_data.py")], HERE),
+        "node": subprocess.check_output(["node", "--version"], text=True).strip(), "python": platform.python_version(),
+        "libraries": dict(VERSIONS), "artifactsSHA256": {k: v[1] for k, v in assets.items()}, "contextBudgets": BUDGETS,
+        "rankers": {"minilm": "cosine with all-MiniLM-L6-v2", "bm25": {"k1": 1.2, "b": 0.75}},
+        "plans": {**settings, WINDOW_NAME: {"tokens": WINDOW, "overlap": OVERLAP}}, "tasks": {},
+    }
+    if "hotpotqa" in tasks:
+        report["libraries"]["pyarrow"] = version("pyarrow")
+    tokenizer, model = load_model()
+    with TemporaryDirectory() as temp:
+        directory = Path(temp)
+        write(directory / "plans.json", settings)
+        for task in tasks:
+            report["tasks"][task] = evaluate(task, root, directory, tokenizer, model, settings)
+    serialized = json.dumps(report, indent=2, allow_nan=False) + "\n"
+    out.parent.mkdir(parents=True, exist_ok=True)
+    with out.open("x", encoding="utf-8", newline="\n") as target:
+        target.write(serialized)
+    print(f"Saved {out}", flush=True)
+
+
+if __name__ == "__main__":
+    main()
