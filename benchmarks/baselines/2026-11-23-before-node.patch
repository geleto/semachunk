+"""Source documents, candidate pools and complete sets of human-labelled evidence."""
+
+from collections import Counter, defaultdict
+from dataclasses import dataclass
+import json
+import tarfile
+import zipfile
+
+from corpora import Document, answer_span, compact, fetch
+
+
+ASSETS = {
+    "cuad.zip": (
+        "https://raw.githubusercontent.com/The-Atticus-Project/cuad/67faa0e6023b04fcaae6cc09497ab00e5d63a2a2/data.zip",
+        "f8161d18bea4e9c05e78fa6dda61c19c846fb8087ea969c172753bc2f45b999a"),
+    "qasper-test.tgz": (
+        "https://qasper-dataset.s3.us-west-2.amazonaws.com/qasper-test-and-evaluator-v0.3.tgz",
+        "72a52a41193e2838b8074f80ac074b94f956b84886c36a61c58a7df4171bdd72"),
+    "hotpot.parquet": (
+        "https://huggingface.co/datasets/hotpotqa/hotpot_qa/resolve/1908d6afbbead072334abe2965f91bd2709910ab/distractor/validation-00000-of-00001.parquet",
+        "c20b638ca82b21d04fe12e14ff417ad05153d4d215a65de54497fca4e972f7c6"),
+}
+
+
+@dataclass
+class Question:
+    id: str
+    text: str
+    pool: tuple[int, ...]  # Documents available to this question.
+    references: list[list[tuple[int, int, int]]]  # Alternative sets of (document, char start, char end).
+    kind: str = ""
+
+
+def evenly_spaced(items, count):
+    if len(items) < count:
+        raise ValueError("Sample larger than the source partition")
+    return [items[i * len(items) // count] for i in range(count)]
+
+
+def join_parts(parts):
+    """Keep each source part's position, including gaps in numbered sentence lists."""
+    text, spans = [], []
+    cursor = 0
+    for part in parts:
+        clean = compact(part or "")
+        if clean:
+            text.append(clean)
+            spans.append((cursor, cursor + len(clean)))
+            cursor += len(clean) + 1
+        else:
+            spans.append(None)
+    return " ".join(text), spans
+
+
+def cuad():
+    with zipfile.ZipFile(fetch("cuad.zip", ASSETS)) as archive:
+        rows = json.loads(archive.read("test.json"))["data"]
+    docs, questions, counts = [], [], Counter()
+    for i, row in enumerate(evenly_spaced(rows, 8)):
+        paragraph, = row["paragraphs"]
+        raw = paragraph["context"]
+        text = compact(raw)
+        docs.append(Document(row["title"], "test", text, source_text=raw))
+        for qa in paragraph["qas"]:
+            if qa["is_impossible"]:
+                counts["noAnnotatedClause"] += 1
+                continue
+            spans = [answer_span(raw, text, a) for a in qa["answers"]]
+            if not spans or None in spans:
+                raise ValueError(f"Invalid CUAD answer offset in {qa['id']}")
+            reference = [(i, a, b) for a, b in sorted(set(spans))]
+            questions.append(Question(qa["id"], qa["question"], (i,), [reference]))
+    return docs, questions, counts
+
+
+def qasper():
+    with tarfile.open(fetch("qasper-test.tgz", ASSETS)) as archive:
+        rows = json.load(archive.extractfile("qasper-test-v0.3.json"))
+    docs, questions, counts = [], [], Counter()
+    for i, (paper, row) in enumerate(evenly_spaced(list(rows.items()), 16)):
+        parts = [row["title"], row["abstract"]]
+        for section in row["full_text"]:
+            parts.extend([section["section_name"], *section["paragraphs"]])
+        parts.extend(figure["caption"] for figure in row["figures_and_tables"])
+        text, spans = join_parts(parts)
+        docs.append(Document(paper, "test", text, source_text="\n\n".join(p for p in parts if p)))
+        positions = defaultdict(list)
+        for part, span in zip(parts, spans, strict=True):
+            if span:
+                positions[compact(part)].append((i, *span))
+        for qa in row["qas"]:
+            alternatives = []
+            for annotation in qa["answers"]:
+                answer = annotation["answer"]
+                if answer["unanswerable"]:
+                    continue
+                matches = [positions.get(compact(p), []) for p in answer["evidence"]]
+                if matches and all(len(m) == 1 for m in matches):
+                    alternatives.append([m[0] for m in matches])
+                else:
+                    counts["unmappedOrNontextAnnotations"] += 1
+            if alternatives:
+                questions.append(Question(qa["question_id"], qa["question"], (i,), alternatives))
+            elif all(a["answer"]["unanswerable"] for a in qa["answers"]):
+                counts["unanswerableQuestions"] += 1
+            else:
+                counts["noCompleteTextReference"] += 1
+    return docs, questions, counts
+
+
+def hotpot():
+    import pyarrow.parquet as parquet
+
+    table = parquet.read_table(fetch("hotpot.parquet", ASSETS))
+    types = table["type"].to_pylist()
+    indices = [i for kind in ("bridge", "comparison")
+               for i in evenly_spaced([j for j, value in enumerate(types) if value == kind], 32)]
+    docs, questions = [], []
+    doc_ids = {}
+    for row in table.take(sorted(indices)).to_pylist():
+        context = row["context"]
+        pool = []
+        facts = {}
+        for title, sentences in zip(context["title"], context["sentences"], strict=True):
+            text, spans = join_parts([title + ".", *sentences])
+            if title not in doc_ids:
+                doc_ids[title] = len(docs)
+                docs.append(Document(title, "validation", text, source_text=title + ".\n\n" + " ".join(s for s in sentences if s)))
+            d = doc_ids[title]
+            if docs[d].text != text or d in pool:
+                raise ValueError(f"Ambiguous HotpotQA source {title} in {row['id']}")
+            pool.append(d)
+            for j, span in enumerate(spans[1:]):
+                if span:
+                    facts[title, j] = (d, *span)
+        support = row["supporting_facts"]
+        reference = [facts[key] for key in zip(support["title"], support["sent_id"], strict=True)]
+        if not reference:
+            raise ValueError(f"Missing HotpotQA evidence in {row['id']}")
+        questions.append(Question(row["id"], row["question"], tuple(pool), [reference], row["type"]))
+    return docs, questions, {}
