@@ -0,0 +1,23 @@
+// Configuration steps and percentages are decimal quantities. Keep their
+// arithmetic exact until the cutoff or integral candidate count is needed.
+function decimalParts(value) {
+    const [mantissa, exponent = '0'] = value.toString().split('e');
+    const [whole, fraction = ''] = mantissa.split('.');
+    return { units: BigInt(whole + fraction), places: fraction.length - Number(exponent) };
+}
+
+export function addHundredths(base, change) {
+    if (change === 0) return base;
+    const { units, places } = decimalParts(base);
+    const scale = Math.max(places, 2);
+    const adjusted = units * 10n ** BigInt(scale - places) + BigInt(change) * 10n ** BigInt(scale - 2);
+    return Number(`${adjusted}e-${scale}`);
+}
+
+export function createPercentageLimit(percent) {
+    // A JS array's length times a whole percentage fits exactly in a Number.
+    if (Number.isInteger(percent)) return count => Math.floor(count * percent / 100);
+    const { units, places } = decimalParts(percent);
+    const divisor = 10n ** BigInt(places + 2);
+    return count => Number(BigInt(count) * units / divisor);
+}
