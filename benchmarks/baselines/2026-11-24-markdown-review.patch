new file mode 100644
index 0000000..1d608dd
--- /dev/null
+++ b/benchmarks/review-controls.mjs
@@ -0,0 +1,69 @@
+import assert from 'node:assert/strict';
+import { existsSync, readFileSync, writeFileSync } from 'node:fs';
+import { manifest, markdownCorpora } from './markdown-corpora.mjs';
+import { evaluate, prepareDataset } from './markdown-evaluation.mjs';
+import { model, encodingName, openReplay } from './encoder.mjs';
+import { sha256 } from './corpora.mjs';
+import { macro, paired } from './markdown-decisions.mjs';
+
+const read = p => JSON.parse(readFileSync(p, 'utf8'));
+const split = process.argv[4] ?? 'replication';
+const data = await markdownCorpora(split), samples = manifest(data);
+assert.deepEqual(samples, read('benchmarks/results/2026-11-23-markdown-samples.json')[split]);
+const archived = read('benchmarks/results/2026-11-23-markdown-rule-replication.json');
+const file = process.argv[2];
+const suite = process.argv[3] ?? 'original';
+assert.ok(['original', 'extra', 'updated', 'public'].includes(suite));
+const report = existsSync(file) ? read(file) : { revision: '7b3d07a', model, encodingName,
+    suite, split, samplesSHA256: sha256(JSON.stringify(samples)), policies: {}, comparisons: {} };
+assert.equal(Boolean(process.env.REVIEW_MARKDOWN_PARSER), ['updated', 'public'].includes(suite));
+assert.equal(report.samplesSHA256, sha256(JSON.stringify(samples)));
+if (report.suite) assert.equal(report.suite, suite);
+const encoder = await openReplay();
+for (const [task, dataset] of Object.entries(data)) {
+    await prepareDataset(dataset, encoder);
+    if (task === 'hotpotqa') for (const q of dataset.questions) q.group = q.pooled?.[0] ?? 0;
+}
+const save = () => writeFileSync(file, JSON.stringify(report, null, 2) + '\n');
+for (const tokens of [256, 512]) {
+    const base = { method: 'fixed', adaptive: true, tokens };
+    let arms = { frozen: base, pack: { method: 'pack', tokens }, pack3: { method: 'pack', tokens, maxUnits: 3 } };
+    if (suite === 'original') {
+        arms.sweep = { ...base, sweep: true };
+        arms.absorb = { ...base, absorb: 16 };
+        for (const seed of [1, 2, 3]) arms['shuffle' + seed] = { ...base, shuffle: seed };
+    }
+    if (suite === 'updated') arms.absorb = { ...base, absorb: 16 };
+    if (suite === 'public') arms = { frozen: { method: 'public-markdown', tokens },
+        children: { method: 'public-markdown', tokens, unmerged: true } };
+    if (suite === 'extra') {
+        arms = { random30: { method: 'fixed', tokens, randomCut: true, cutoff: 0.3 } };
+        if (tokens === 256) {
+            arms.children = { method: 'pack', maxUnits: 1, tokens };
+            arms.parents = { ...arms.children, parents: true };
+        }
+    }
+    for (const [arm, policy] of Object.entries(arms)) {
+        const name = arm + '/t' + tokens;
+        const row = report.policies[name] ??= { policy, tasks: {} };
+        for (const [task, dataset] of Object.entries(data)) {
+            if (row.tasks[task]) continue;
+            const result = await evaluate(task, dataset, policy, encoder, 'semantic');
+            if (suite === 'original' && (arm === 'frozen' || arm === 'pack')) {
+                const expected = archived.policies[name].tasks[task];
+                assert.equal(result.bodyHash, expected.bodyHash, name + ' ' + task);
+                assert.deepEqual(result.complete512, expected.complete512, name + ' ' + task);
+            }
+            const { bodyHash, questions, calls, embeddedTokens, indexTexts, indexTokens, chunkTokens, retrieval, complete512 } = result;
+            row.tasks[task] = { bodyHash, questions, calls, embeddedTokens, indexTexts, indexTokens, chunkTokens, retrieval, complete512 };
+            save();
+            console.log(name, task, encoder.stats.apiRequests, 'cumulative paid requests');
+        }
+        row.macroComplete512 = macro(row);
+        const ref = (suite === 'extra' ? archived : report).policies['frozen/t' + tokens];
+        const { deltaPer100, ci95 } = paired(row, ref, data);
+        report.comparisons[name] = { deltaPer100, ci95 };
+        save();
+    }
+}
+encoder.close();
