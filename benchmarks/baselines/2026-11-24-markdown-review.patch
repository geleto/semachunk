index 0000000..98d0647
--- /dev/null
+++ b/benchmarks/review-summary.mjs
@@ -0,0 +1,72 @@
+import assert from 'node:assert/strict';
+import { readFileSync, writeFileSync } from 'node:fs';
+import { basename, dirname, join } from 'node:path';
+import { sha256 } from './corpora.mjs';
+import { groupInterval } from './markdown-decisions.mjs';
+import { markdownCorpora } from './markdown-corpora.mjs';
+
+const read = name => JSON.parse(readFileSync(name + '.json', 'utf8'));
+const historic = read('review-results'), extra = read('review-extra'), updated = read('review-updated');
+const independent = ['confirmation', 'rules-test'];
+const direct = Object.fromEntries([...independent, 'replication'].map(k => [k, read('public-' + k)]));
+const datasets = {};
+for (const split of Object.keys(direct)) datasets[split] = await markdownCorpora(split);
+const arm = t => (t === 'hotpotqa' ? 'pooled' : 'document') + '/dense';
+for (const counts of [256, 512]) {
+    const key = 'frozen/t' + counts;
+    for (const t of Object.keys(datasets.replication)) {
+        const a = updated.policies[key].tasks[t], b = direct.replication.policies[key].tasks[t];
+        for (const field of ['bodyHash', 'calls', 'embeddedTokens', 'retrieval', 'complete512']) assert.deepEqual(a[field], b[field]);
+    }
+}
+// Combine repeated seeds within each question. Independently resample
+// contracts, papers, reports and whole multi-hop pools within each task.
+function contrast(sets, testKeys, controlKey) {
+    const groups = [], taskMeans = [];
+    for (const task of Object.keys(datasets.replication)) {
+        const taskGroups = [];
+        let sum = 0, count = 0;
+        for (const [split, report] of sets) {
+            const grouped = new Map(), queries = datasets[split][task].questions;
+            const hits = k => report.policies[k].tasks[task].complete512[arm(task)];
+            const control = hits(controlKey), tests = testKeys.map(hits);
+            for (const [i, q] of queries.entries()) {
+                const diff = tests.reduce((s, run) => s + Number(run[i]), 0) / tests.length - Number(control[i]);
+                const group = task === 'hotpotqa' ? q.pooled?.[0] ?? 0 : q.group;
+                const entry = grouped.get(group) ?? [0, 0];
+                entry[0] += diff; entry[1]++;
+                sum += diff; count++;
+                grouped.set(group, entry);
+            }
+            taskGroups.push(...grouped.values());
+        }
+        groups.push(taskGroups);
+        taskMeans.push(sum / count);
+    }
+    return { deltaPoints: 100 * taskMeans.reduce((a, b) => a + b) / taskMeans.length, ci95: groupInterval(groups) };
+}
+function compactReport(policies) {
+    return Object.fromEntries(Object.entries(policies).map(([name, row]) => [name, { policy: row.policy,
+        macroComplete512: row.macroComplete512, tasks: Object.fromEntries(Object.entries(row.tasks).map(([task, result]) => {
+            const { retrieval, complete512, ...costs } = result;
+            return [task, { ...costs, retrieval: retrieval[arm(task)], complete512: complete512[arm(task)] }];
+        })) }]));
+}
+const estimates = {};
+for (const tokens of [256, 512]) {
+    const size = '/t' + tokens, scored = 'frozen' + size;
+    estimates['shuffled mean' + size] = contrast([['replication', historic]], [1, 2, 3].map(i => 'shuffle' + i + size), scored);
+    estimates['unmerged confirmation' + size] = contrast(independent.map(k => [k, direct[k]]), ['children' + size], scored);
+}
+estimates['parent vs child/t256'] = contrast([['replication', extra]], ['parents/t256'], 'children/t256');
+const source = process.env.REVIEW_MARKDOWN_PARSER;
+const hashes = Object.fromEntries([source, join(dirname(source), 'sentences.js')].map(p =>
+    [basename(p), sha256(readFileSync(p, 'utf8').replaceAll('\r\n', '\n'))]));
+const report = { revision: historic.revision, updatedSourceSHA256: hashes, model: historic.model, encoding: historic.encodingName,
+    metric: 'Dense complete evidence; equal task weights, pooled HotpotQA. Units are UTF-16 source offsets. Meeting outcomes use token recall.',
+    samplesSHA256: Object.fromEntries(Object.entries(direct).map(([k, r]) => [k, r.samplesSHA256])), estimates,
+    historical: { policies: compactReport({ ...historic.policies, ...extra.policies }), comparisons: { ...historic.comparisons, ...extra.comparisons } },
+    updated: { policies: compactReport({ ...updated.policies, ...direct.replication.policies }), comparisons: { ...updated.comparisons, ...direct.replication.comparisons } },
+    independent: Object.fromEntries(independent.map(k => [k, { policies: compactReport(direct[k].policies), comparisons: direct[k].comparisons }])),
+    meetings: read('review-turns') };
+writeFileSync(process.argv[2], JSON.stringify(report, null, 2) + '\n', { flag: 'wx' });
diff --git a/benchmarks/review-turns.mjs b/benchmarks/review-turns.mjs
new file mode 100644
index 0000000..c25bbf4
--- /dev/null
+++ b/benchmarks/review-turns.mjs
@@ -0,0 +1,53 @@
+import assert from 'node:assert/strict';
+import { writeFileSync } from 'node:fs';
+import { openReplay } from './encoder.mjs';
+import { groupInterval } from './markdown-decisions.mjs';
+import { evaluate, prepareDataset } from './markdown-evaluation.mjs';
+import { meetings } from './semantic-corpora.mjs';
+
+// QMSum supplies true turn boundaries. Change only their Markdown representation
+// and check that every remapped annotation still quotes exactly the same words.
+function paragraphTurns(dataset) {
+    const offsets = [];
+    const docs = dataset.docs.map(({ id, source }) => {
+        const map = new Uint32Array(source.length + 1);
+        let extra = 0;
+        for (let i = 0; i < source.length; i++) {
+            if (source[i] === '\n') extra++;
+            map[i + 1] = i + 1 + extra;
+        }
+        offsets.push(map);
+        return { id, source: source.replaceAll('\n', '\n\n') };
+    });
+    const questions = dataset.questions.map(q => ({ ...q, references: q.references.map(ref => ref.map(([d, a, b]) => {
+        const start = offsets[d][a], end = offsets[d][b];
+        assert.equal(docs[d].source.slice(start, end), dataset.docs[d].source.slice(a, b));
+        return [d, start, end];
+    })) }));
+    return { docs, questions };
+}
+
+const output = {}, encoder = await openReplay();
+for (const split of ['test', 'val']) {
+    const original = await meetings(split), turns = paragraphTurns(original);
+    const cohort = output[split] = { documents: original.docs.length, ids: original.questions.map(q => q.id), arms: {} };
+    for (const [arm, dataset] of [['lines', original], ['paragraphs', turns]]) {
+        await prepareDataset(dataset, encoder);
+        const row = await evaluate('qmsum', dataset, { method: 'fixed', adaptive: true, tokens: 256 }, encoder, 'semantic');
+        const { bodyHash, chunkTokens, embeddedTokens } = row;
+        cohort.arms[arm] = { bodyHash, chunkTokens, embeddedTokens, recall: row.recall512['document/dense'],
+            retrieval: row.retrieval['document/dense'] };
+        console.log(split, arm, cohort.arms[arm].retrieval[512].recall);
+    }
+    const diffs = new Map();
+    for (const [i, q] of original.questions.entries()) {
+        const pair = diffs.get(q.group) ?? [0, 0];
+        pair[0] += cohort.arms.paragraphs.recall[i] - cohort.arms.lines.recall[i];
+        pair[1]++;
+        diffs.set(q.group, pair);
+    }
+    cohort.deltaPoints = 100 * (cohort.arms.paragraphs.retrieval[512].recall - cohort.arms.lines.retrieval[512].recall);
+    cohort.ci95 = groupInterval([[...diffs.values()]]);
+    writeFileSync(process.argv[2], JSON.stringify(output, null, 2) + '\n');
+}
+encoder.close();
