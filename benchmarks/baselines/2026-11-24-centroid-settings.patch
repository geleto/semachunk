@@ -0,0 +1,277 @@
+import assert from 'node:assert/strict';
+import { existsSync } from 'node:fs';
+import { mkdir, readFile, writeFile } from 'node:fs/promises';
+import { join, resolve } from 'node:path';
+import { chunkText } from '../src/index.js';
+import { assets, cuad, hotpotqa, qasper, sha256 } from './corpora.mjs';
+import { dimension, model, openEncoder } from './encoder.mjs';
+import { groupInterval } from './markdown-decisions.mjs';
+import { evaluateRag, prepare, ragPlans, ragTasks } from './rag.mjs';
+
+const [stage, directory, target] = process.argv.slice(2);
+const tasks = ['cuad', 'qasper', 'hotpotqa'];
+const thresholds = [0.3, 0.4, 0.5, 0.6, 0.7];
+const scales = [0.75, 0.9, 1, 1.1, 1.25];
+const read = async path => JSON.parse(await readFile(path, 'utf8'));
+const save = (path, data) => writeFile(path, JSON.stringify(data, null, 2) + '\n', {flag:'wx'});
+const file = name => join(directory, name + '.json');
+const priorResults = name => read(resolve('benchmarks/results', name + '.json'));
+
+function policyGrid() {
+    const policies = {};
+    function add(group, mode, cutoff, parameter) {
+        const name = [group === null ? 'off' : 'g' + group, mode, cutoff, parameter].filter(x => x !== undefined).join('/');
+        assert.ok(!policies[name], name);
+        const options = {maxChunkSize:500, groupSentences:group !== null, similarityThreshold:group ?? 0.5};
+        if (mode === 'group') options.combineChunks = false;
+        else if (cutoff === 'doc') options.mergeThresholdMode = 'document';
+        else options.combineChunksSimilarityThreshold = cutoff;
+        if (!['group','full'].includes(mode)) {
+            options.centroid = {mode};
+            if (mode === 'min' || mode === 'max') options.centroid.scale = parameter;
+            if (mode === 'gate' || mode === 'late') options.centroid.floor = parameter;
+            if (mode === 'blend') options.centroid.weight = parameter;
+        }
+        policies[name] = {name, group, mode, cutoff, parameter, options};
+    }
+    for (const base of thresholds) add(base, 'group');
+    for (const group of [null, 0.4, 0.5, 0.6]) {
+        add(group, 'full', 'doc');
+        for (const t of thresholds) {
+            add(group,'full',t);
+            add(group,'centroid',t);
+            for (const c of thresholds) {
+                add(group,'gate',t,c);
+                // For c <= t the delayed and immediate gates agree on single sentences.
+                if (c > t) add(group,'late',t,c);
+            }
+            for (const s of scales) for (const mode of ['min','max']) add(group,mode,t,s);
+            for (const w of [0.25,0.5,0.75]) add(group,'blend',t,w);
+        }
+    }
+    for (const group of [0.3,0.7]) for (const t of thresholds) add(group,'full',t);
+    return policies;
+}
+const grid = policyGrid();
+
+async function holdout(task) {
+    const prior = (await priorResults('2026-11-23-openai-rag')).tasks[task];
+    const md = await priorResults('2026-11-23-markdown-samples');
+    const excluded = new Set([...prior.documents,...Object.values(md).flatMap(part => part[task].documents)]);
+    const excludedQuestions = new Set([...prior.questionIds,...Object.values(md).flatMap(part => part[task].questions)]);
+    function order(rows, id) {
+        return rows.map(row => [sha256('semachunk-centroid-holdout-v1/' + id(row)),row])
+            .sort(([a],[b]) => a < b ? -1 : a > b ? 1 : 0).map(([,row]) => row);
+    }
+    function pick(rows, id, count) {
+        const chosen = order(rows.filter(row => !excluded.has(id(row))),id).slice(0,count);
+        assert.equal(chosen.length,count);
+        return chosen;
+    }
+    let data;
+    if (task === 'cuad') data = await cuad(rows => pick(rows, r => r.title,16));
+    if (task === 'qasper') data = await qasper(rows => pick(rows, r => r[0],32));
+    if (task === 'hotpotqa') data = await hotpotqa(rows => {
+        const previous = new Set(excluded), selected = [];
+        for (const kind of ['bridge','comparison']) {
+            const indices = rows.flatMap((r,i) => r.type === kind && !excludedQuestions.has(r._id) ? [i] : []);
+            let count = 0;
+            for (const i of order(indices,i => rows[i]._id)) {
+                const titles = rows[i].context.map(([title])=>title);
+                if (new Set(titles).size !== titles.length || titles.some(t => previous.has(t))) continue;
+                for (const t of titles) previous.add(t);
+                selected.push(i);
+                if (++count === 32) break;
+            }
+            assert.equal(count,32);
+        }
+        return selected;
+    });
+    assert.ok(data.docs.every(d=>!excluded.has(d.title)));
+    assert.ok(data.questions.every(q=>!excludedQuestions.has(q.id)));
+    return data;
+}
+
+function summarize(row, task, ids) {
+    const retrieval = task === 'hotpotqa' ? row.pooledRetrieval : row.retrieval;
+    const totals = ranker => [256,512,1024].map(b => retrieval[ranker][b].complete);
+    const primary = retrieval.dense[256];
+    return {dense:totals('dense'), bm25:totals('bm25'), recall:primary.evidenceRecall,
+        chunks:row.chunks, calls:row.providerCalls, inputs:row.providerTexts, tokens:row.providerTokens,
+        ...(ids ? {completeIds:primary.completeQuestionIds ?? []} : {})};
+}
+
+async function evaluate(split,task,names,policies = grid) {
+    const historical = split === 'calibration';
+    const data = historical ? await ragTasks[task]() : await holdout(task);
+    const plans = Object.fromEntries(names.map(n=>[n,policies[n].options]));
+    const encoder = openEncoder(resolve('.env'));
+    globalThis.fetch = async () => { throw new Error('Score comparisons must replay cached inputs'); };
+    try {
+        const run = await evaluateRag(task,chunkText,encoder,plans,data,historical ? ragPlans() : plans);
+        assert.equal(run.precomputation.apiRequests,0);
+        const rows = Object.fromEntries(names.map(n=>[n,summarize(run.scores[n],task,!historical)]));
+        const groups = data.questions.map(q=>task === 'hotpotqa' ? q.id : data.docs[q.pool[0]].title);
+        return {questionIds:run.questionIds, documents:run.documents, groups, exclusions:run.exclusions,
+            distinctTexts:run.distinctTexts,textsSHA256:run.textsSHA256,vectorsSHA256:run.vectorsSHA256,
+            precomputation:run.precomputation,rows};
+    } finally { encoder.close(); }
+}
+const isMixed = p => ['gate','late','min','max','blend'].includes(p.mode);
+function select(cal) {
+    const scores = Object.values(grid).map(p => {
+        let macro = 0, tokens = 0, calls = 0;
+        for (const task of tasks) {
+            const r = cal[task].rows[p.name];
+            macro += r.dense[0] / cal[task].questionIds.length / tasks.length;
+            tokens += r.tokens;
+            calls += r.calls;
+        }
+        return {p,macro,tokens,calls};
+    });
+    scores.sort((a,b)=>b.macro-a.macro || a.tokens-b.tokens || a.calls-b.calls);
+    const best = predicate => scores.find(x=>predicate(x.p)).p.name;
+    const existing = p => p.mode === 'group' || p.mode === 'full';
+    const nominees = {publicPriority:'off/full/0.5',publicSeparate:'g0.5/full/0.5',
+        tunedPriority:best(p=>p.group === null && p.mode === 'full'),
+        groupingOnly:best(p=>p.mode === 'group'),tunedSeparate:best(p=>p.group !== null && p.mode === 'full'),
+        incumbent:best(existing),challenger:best(p=>!existing(p)),
+        jointAlone:best(p=>p.group === null && isMixed(p)),both:best(p=>p.group !== null && isMixed(p)),
+        jointAtDefault:best(p=>p.group === null && p.cutoff === 0.5 && isMixed(p)),
+        bothAtDefault:best(p=>p.group === 0.5 && p.cutoff === 0.5 && isMixed(p))};
+    for (const mode of ['gate','late','min','max','blend','centroid']) {
+        nominees[mode] = best(p=>p.mode === mode && p.group === null);
+        nominees[mode+'AtDefault'] = best(p=>p.mode === mode && p.group === null && p.cutoff === 0.5);
+    }
+    for (const mode of ['min','max']) {
+        nominees[mode+'Unscaled'] = best(p=>p.mode === mode && p.group === null && p.parameter === 1);
+        nominees[mode+'AtDefaultUnscaled'] = 'off/'+mode+'/0.5/1';
+        for (const preference of ['down','up']) {
+            nominees[mode+'AtDefault'+preference] = best(p=>p.mode === mode && p.group === null && p.cutoff === 0.5 &&
+                (preference === 'up' ? p.parameter > 1 : p.parameter < 1));
+        }
+    }
+    return nominees;
+}
+
+function comparisons(valid,names,reference) {
+    const result = {};
+    for (const name of new Set(names)) {
+        const perTask = {}, groups = [];
+        let delta = 0;
+        for (const task of tasks) {
+            const v = valid[task], wins = [], losses = [], grouped = new Map();
+            const current = new Set(v.rows[name].completeIds), control = new Set(v.rows[reference].completeIds);
+            for (const [i,id] of v.questionIds.entries()) {
+                const change = Number(current.has(id)) - Number(control.has(id));
+                if (change > 0) wins.push(id);
+                if (change < 0) losses.push(id);
+                const label = v.groups[i];
+                if (!grouped.has(label)) grouped.set(label,[0,0]);
+                const g = grouped.get(label);
+                g[0] += change;
+                g[1]++;
+            }
+            perTask[task] = {wins,losses};
+            delta += (wins.length-losses.length) / v.questionIds.length * 100 / tasks.length;
+            groups.push([...grouped.values()]);
+        }
+        result[name] = {deltaPer100:delta,ci95:groupInterval(groups),perTask};
+    }
+    return result;
+}
+
+// Only a downscaled minimum or an upscaled maximum changes singleton eligibility.
+function singletonControls(nominees) {
+    const policies = {'off/full/0.5':grid['off/full/0.5']};
+    for (const key of ['minAtDefaultdown','maxAtDefaultup']) {
+        const name = nominees[key], p = grid[name], options = p.options;
+        const cutoff = p.cutoff / p.parameter;
+        policies[name] = p;
+        policies[name+'/compound-only'] = {options:{...options,centroid:{...options.centroid,compoundOnly:true}}};
+        policies[name+'/matched-full'] = {options:{maxChunkSize:500,combineChunksSimilarityThreshold:cutoff}};
+    }
+    return policies;
+}
+
+await mkdir(directory,{recursive:true});
+if (stage === 'preflight' || stage === 'prefill') {
+    assert.ok(tasks.includes(target));
+    const data = await holdout(target), encoder = openEncoder(resolve('.env'));
+    try {
