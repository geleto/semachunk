--- /dev/null
+++ b/benchmarks/centroid-study.test.mjs
@@ -0,0 +1,66 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { chunkText } from '../src/index.js';
+
+const sentences = ['Alpha rests.', 'Bravo rests.', 'Cedar rests.', 'Daffodil rests.'];
+const ab = sentences.slice(0,2).join(' '), abc = sentences.slice(0,3).join(' ');
+const vector = (degrees,magnitude=1) => [Math.cos(degrees*Math.PI/180)*magnitude,Math.sin(degrees*Math.PI/180)*magnitude];
+function example(directions) {
+    const calls = [];
+    async function embed(texts) {
+        calls.push([...texts]);
+        return texts.map(text => { assert.ok(directions.has(text),text); return directions.get(text); });
+    }
+    async function run(n,options) {
+        calls.length = 0;
+        return await chunkText(sentences.slice(0,n).join('\n\n'),embed,{similarityThreshold:0.5,returnEmbedding:false,...options});
+    }
+    return {run,calls};
+}
+test('scaling the centroid changes min and max eligibility at the same public cutoff', async () => {
+    const dirs = new Map([[sentences[0],vector(0,5)],[sentences[1],vector(30)],[sentences[2],vector(80,7)],[ab,vector(80)]]);
+    const {run} = example(dirs);
+    async function check(mode,scale,expected) {
+        assert.deepEqual((await run(3,{centroid:{mode,scale}})).map(c=>c.text),expected);
+    }
+    await check('min',1,[ab,sentences[2]]);
+    await check('min',1.25,[abc]);
+    dirs.set(ab,vector(170));
+    await check('max',1,[ab,sentences[2]]);
+    await check('max',1.25,[abc]);
+});
+test('an independent stricter centroid cutoff applies to singletons unless delayed', async () => {
+    const {run} = example(new Map([[sentences[0],vector(0)],[sentences[1],vector(53.13)]]));
+    for (const [mode,expected] of [['gate',sentences.slice(0,2)],['late',[ab]]]) {
+        assert.deepEqual((await run(2,{centroid:{mode,floor:0.7}})).map(c=>c.text),expected);
+    }
+});
+test('scaling only compound pairs preserves the full-text cutoff on the first join', async () => {
+    for (const [mode,scale,cosine,raw,delayed] of [
+        ['max',1.25,0.45,[ab],sentences.slice(0,2)],
+        ['min',0.9,0.53,sentences.slice(0,2),[ab]]
+    ]) {
+        const {run} = example(new Map([[sentences[0],[1,0]],[sentences[1],[cosine,Math.sqrt(1-cosine**2)]]]));
+        assert.deepEqual((await run(2,{centroid:{mode,scale}})).map(c=>c.text),raw);
+        assert.deepEqual((await run(2,{centroid:{mode,scale,compoundOnly:true}})).map(c=>c.text),delayed);
+    }
+});
+test('stacked passes use original sentence vectors on both sides of a grouped boundary', async () => {
+    const dirs = new Map([[sentences[0],vector(0,11)],[sentences[1],vector(20)],[sentences[2],vector(85,7)],[ab,vector(85)]]);
+    const {run,calls} = example(dirs);
+    const grouping = {groupSentences:true,dynamicThresholdLowerBound:0.8,dynamicThresholdUpperBound:0.8};
+    assert.deepEqual((await run(3,grouping)).map(c=>c.text),[abc]);
+    assert.deepEqual((await run(3,{...grouping,centroid:{mode:'min',scale:1}})).map(c=>c.text),[ab,sentences[2]]);
+    const chunks = await run(3,{...grouping,centroid:{mode:'centroid'}});
+    assert.deepEqual(chunks.map(c=>c.text),[ab,sentences[2]]);
+    assert.deepEqual(calls,[sentences.slice(0,3)]);
+    const indexed = await run(3,{...grouping,centroid:{mode:'centroid'},returnEmbedding:true});
+    assert.deepEqual(indexed[0].embedding,dirs.get(ab));
+});
+test('uneven merges retain one vote per sentence', async () => {
+    const {run} = example(new Map([[sentences[0],vector(0,4)],[sentences[1],vector(0,0.1)],[sentences[2],vector(60,7)],
+        [sentences[3],vector(82,23)],[ab,vector(60,2)],[abc,vector(82,5)]]));
+    const options = {similarityThreshold:0.49,maxMergesPerPass:1};
+    assert.deepEqual((await run(4,options)).map(c=>c.text),[sentences.join(' ')]);
+    assert.deepEqual((await run(4,{...options,centroid:{mode:'gate',floor:0.49}})).map(c=>c.text),[abc,sentences[3]]);
+});
