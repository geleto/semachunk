+        artifactsSHA256:Object.fromEntries(tasks.map(t=>[t,assets[t].checksum])),targetUTF16:500,budgets:[256,512,1024],
+        thresholds,scales,centroidWeights:[0.25,0.5,0.75],policyCount:Object.keys(grid).length,nominees,
+        comparisonsAgainstTunedIncumbent:comparisons(validation,Object.values(nominees),nominees.incumbent),
+        comparisonsAtPublicCutoff:comparisons(validation,[nominees.minAtDefault,nominees.maxAtDefault,nominees.jointAtDefault],nominees.publicPriority),
+        scaledAtDefault,singletonDiagnostics,calibration,validation};
+    await save(target,result);
+    console.log('Saved',target);
+} else throw new Error('Choose preflight, prefill, calibration, select, validation, diagnostic or report');
diff --git a/benchmarks/centroid-study.test.mjs b/benchmarks/centroid-study.test.mjs
