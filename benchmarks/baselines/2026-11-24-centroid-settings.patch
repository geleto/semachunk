+    await save(file('nominees'),nominees);
+    console.log(nominees);
+} else if (stage === 'report') {
+    const load = async stage => Object.fromEntries(await Promise.all(tasks.map(async t=>[t,await read(file(stage+'-'+t))])));
+    const calibration = await load('calibration'), validation = await load('validation'), nominees = await read(file('nominees'));
